      "description": "Set up a CLIO Spack on a clio-relay site that reuses what the site already has. It shallow-clones the Spack release the site runs (pinned by commit) into <site_home>/spack, points upstreams.yaml at the site install tree, runs compiler find, registers build tools with external find --not-buildable, sets packages:mpi:buildable:false and records module-only MPIs as candidate externals. MPI is never externalized from PATH. Config lives in the checkout and SPACK_DISABLE_LOCAL_CONFIG keeps ~/.spack out. Idempotent; it never installs, builds or installs jarvis-cd. The first call returns the relay exec call and the approval text; the second, with relay_result, returns the report, including the JARVIS_SPACK_ROOT and JARVIS_SPACK_CONFIG to export.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "build_tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Build tools for external find; default a fixed list, never MPI."
          },
          "module_paths": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Module directories to scan for MPIs; default MODULEPATH."
          },
          "relay_result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Leave empty on the first call. On the second call, pass the structured result of the clio-relay exec call this tool returned."
          },
          "root": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The CLIO Spack checkout; default <site_home>/spack."
          },
          "site": {
            "description": "The clio-relay site id, such as ares",
            "type": "string"
          },
          "site_home": {
            "default": "~/.clio-relay",
            "description": "The site's CLIO home: clio-relay's remote_dir for the site.",
            "type": "string"
          },
          "site_install_tree": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The site install tree; default asks the site Spack."
          },
          "site_spack": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The site's own Spack root, such as /mnt/repo/software/spack/spack. Empty when the site has no Spack; then give spack_version."
          },
          "spack_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Spack release to clone; default the site Spack's release."
          }
        },
        "required": [
          "site"
        ],
        "type": "object"
      },
